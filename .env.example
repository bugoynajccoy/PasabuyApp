# Leave empty to use localStorage demo data. Set to your Express API later, e.g.
# VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_BASE_URL=

# Shared data between browsers/devices (run: npm run sync). In dev this defaults to http://<this-host>:4000; set it to override.
# VITE_SYNC_URL=http://192.168.1.5:4000
